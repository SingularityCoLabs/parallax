# Copy to .env and fill in. `parallax` auto-loads ./.env at startup.

# Which provider to use: "fake" (default, offline, scripted demos) or "nvidia".
PARALLAX_PROVIDER=nvidia

# NVIDIA NIM API key (starts with nvapi-). Get one at https://build.nvidia.com.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the model. Any tool-calling NIM model works, e.g.:
#   meta/llama-3.3-70b-instruct   (default)
#   nvidia/llama-3.1-nemotron-70b-instruct
#   qwen/qwen2.5-coder-32b-instruct
# PARALLAX_MODEL=meta/llama-3.3-70b-instruct

# Optional: point at a different OpenAI-compatible endpoint.
# PARALLAX_API_BASE_URL=https://integrate.api.nvidia.com/v1
