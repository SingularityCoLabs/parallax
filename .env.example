# Copy to .env and fill in. `parallax` auto-loads ./.env at startup.

# Which provider to use. One of:
#   fake (default, offline)  anthropic  openai  nvidia  openrouter  moonshot  custom
PARALLAX_PROVIDER=anthropic

# --- Provider API keys (set the one for your provider) ---
# Anthropic (Claude). Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI. https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA NIM (starts with nvapi-). https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OpenRouter. https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Moonshot (Kimi). https://platform.moonshot.ai
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Provider-agnostic override (used before any provider-specific key above).
# PARALLAX_API_KEY=

# --- Web tools ---
# The web_search tool uses Tavily (https://tavily.com — free tier available).
# Set this to enable it; without it, web_search returns a friendly error.
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the model. Each provider has a sensible default, e.g.:
#   anthropic   claude-opus-4-8   (default)
#   openai      gpt-4o
#   nvidia      meta/llama-3.3-70b-instruct
#   moonshot    kimi-k2-0711-preview
# PARALLAX_MODEL=claude-opus-4-8

# Optional: point an OpenAI-compatible provider at a custom endpoint
# (e.g. PARALLAX_PROVIDER=custom for a local vLLM/Ollama server).
# PARALLAX_API_BASE_URL=http://localhost:8000/v1

# --- Model catalog (models.dev) ---
# Parallax enriches its provider catalog from models.dev (cost, context limits,
# capabilities), cached under ~/.parallax/models.json. It works fully offline
# from a bundled snapshot; the fetch only augments it.
# Override the catalog URL (default https://models.dev/api.json):
# PARALLAX_MODELS_URL=https://models.dev/api.json
# Disable the network fetch entirely (use only the bundled snapshot):
# PARALLAX_DISABLE_MODELS_FETCH=1

# --- Updates ---
# On startup Parallax checks npm for a newer version and shows the upgrade
# command (it never installs anything itself). Disable the check:
# PARALLAX_NO_UPDATE_CHECK=1

# --- Interface ---
# On a TTY, `parallax` opens the interactive TUI. Force the plain line-based
# renderer instead (e.g. for logging):
# PARALLAX_NO_TUI=1
