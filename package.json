{
  "name": "@singularitycolabs/parallax",
  "version": "0.1.0-beta.1",
  "description": "A secure, extensible agent runtime with a CLI as its first interface.",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "runtime",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SingularityCoLabs/parallax.git"
  },
  "bugs": {
    "url": "https://github.com/SingularityCoLabs/parallax/issues"
  },
  "homepage": "https://github.com/SingularityCoLabs/parallax#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "parallax": "dist/cli/index.js"
  },
  "scripts": {
    "agent": "node src/cli/index.ts",
    "clean": "node scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "test:package": "node scripts/test-package.mjs",
    "verify:release": "pnpm verify && pnpm test:package",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm verify:release"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
