{
  "name": "parallax",
  "version": "0.1.0",
  "private": true,
  "description": "A secure, extensible agent runtime with a CLI as its first interface.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SingularityCoLabs/parallax.git"
  },
  "bugs": {
    "url": "https://github.com/SingularityCoLabs/parallax/issues"
  },
  "homepage": "https://github.com/SingularityCoLabs/parallax#readme",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "parallax": "./src/cli/index.ts"
  },
  "scripts": {
    "agent": "node src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "commander": "^12.1.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
